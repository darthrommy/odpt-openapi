{
  "name": "odpt-openapi",
  "version": "4.16.0",
  "description": "ODPT API仕様書（HTML）から非公式のOpenAPI定義を生成する",
  "scripts": {
    "parse": "node scripts/parse.ts",
    "build": "node scripts/build.ts",
    "todo": "node scripts/build.ts --todo",
    "lint": "redocly lint dist/openapi.yaml dist/split/*.yaml",
    "all": "pnpm parse && pnpm build && pnpm lint",
    "fetch": "node scripts/fetch.ts",
    "verify": "node scripts/verify.ts",
    "types": "node scripts/types.ts",
    "typecheck": "node scripts/typecheck.ts && tsc -p build/typecheck && tsc6 -p build/typecheck"
  },
  "author": "",
  "license": "CC0-1.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "dependencies": {
    "cheerio": "^1.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@redocly/cli": "^2.54.3",
    "@types/node": "^26.6.3",
    "@typescript/typescript6": "^6.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
